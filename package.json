{
  "name": "olse-receiver-accelerator",
  "version": "0.0.1",
  "description": "A reference repository to help accelerate the development of a GOV.UK One Login Signal Exchange Receiver",
  "homepage": "https://github.com/govuk-one-login/olse-receiver-accelerator#readme",
  "bugs": {
    "url": "https://github.com/govuk-one-login/olse-receiver-accelerator/issues"
  },
  "license": "MIT",
  "author": "GOV.UK One Login",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/govuk-one-login/olse-receiver-accelerator.git"
  },
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --max-warnings 0 --fix .",
    "lint:check": "eslint --max-warnings 0 .",
    "type-check": "tsc --noEmit",
    "container:build": "CONTAINER=true node esbuild.config.mjs",
    "container:dev": "nodemon --exec tsx examples/express-container/server.ts",
    "lambda:build": "AWS_LAMBDA_REFERENCE=true node esbuild.config.mjs",
    "test:vendor": "vitest run --project vendor/unit --config tests/vendor/unit/vitest.config.ts",
    "test:vendor:build": "vitest run --project vendor/build",
    "test:vendor:staging": "vitest run --project vendor/staging",
    "test:unit": "vitest run --project implementor/unit --config tests/implementor/unit/vitest.config.ts",
    "tsFile": "tsx"
  },
  "dependencies": {
    "@aws-lambda-powertools/logger": "^2.34.0",
    "@aws-sdk/client-cloudformation": "^3.1136.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1136.0",
    "@aws-sdk/client-kms": "^3.1136.0",
    "@aws-sdk/client-secrets-manager": "^3.1136.0",
    "@aws-sdk/client-ssm": "^3.1136.0",
    "aws-jwt-verify": "^5.2.1",
    "express": "^5.2.1",
    "fs": "^0.0.1-security",
    "jose": "^6.2.4"
  },
  "devDependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1136.0",
    "@aws-sdk/client-secrets-manager": "^3.1136.0",
    "@eslint/js": "^10.0.1",
    "@tsconfig/node-ts": "^23.6.4",
    "@tsconfig/node24": "^24.0.5",
    "@tsconfig/strictest": "^2.0.8",
    "@types/aws-lambda": "^8.10.162",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.1",
    "@vitest/eslint-plugin": "^1.6.20",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "concurrently": "^10.0.4",
    "dotenv": "^18.0.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "nodemon": "^3.1.11",
    "prettier": "3.9.8",
    "supertest": "^7.1.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1",
    "yaml-cfn": "^0.3.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
