{
  "$schema": "https://raw.githubusercontent.com/govuk-one-login/quality-gates/refs/tags/v0.11.0/schemas/schema.json",
  "services": [
    {
      "serviceTag": "olse-receiver-accelerator",
      "promotionType": "securePipelines",
      "checks": [
        {
          "checkTypes": [
            "code style and linting"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/ensure-sha-pinned-actions.yaml",
            "path": "$.jobs.harden_security"
          }
        },
        {
          "checkTypes": [
            "code style and linting"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/ci.yml",
            "path": "$.jobs.Run-CI-Checks"
          }
        },
        {
          "checkTypes": [
            "unit",
            "vulnerability detection"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/vendor.yml",
            "path": "$.jobs.vendor"
          }
        },
        {
          "checkTypes": [
            "unit"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/ci.yml",
            "path": "$.jobs.Run-Vendor-Checks"
          }
        },
        {
          "checkTypes": [
            "unit"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/ci.yml",
            "path": "$.jobs.Run-Implementor-Checks"
          }
        }
      ]
    }
  ]
}
