{
  "$schema": "https://raw.githubusercontent.com/govuk-one-login/quality-gates/refs/tags/v0.15.0/schemas/schema.json",
  "services": [
    {
      "product": "One Login Signal Exchange",
      "component": "olse-receiver-accelerator",
      "promotionType": "securePipelines",
      "automated": [
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/ensure-sha-pinned-actions.yaml",
            "path": "$.jobs.harden_security"
          },
          "checks": [
            {
              "name": "code style and linting"
            }
          ]
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/ci.yml",
            "path": "$.jobs.Run-CI-Checks"
          },
          "checks": [
            {
              "name": "code style and linting"
            }
          ]
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/vendor.yml",
            "path": "$.jobs.vendor"
          },
          "checks": [
            {
              "name": "unit"
            },
            {
              "name": "vulnerability detection"
            }
          ]
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/ci.yml",
            "path": "$.jobs.Run-Vendor-Checks"
          },
          "checks": [
            {
              "name": "unit"
            }
          ]
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/ci.yml",
            "path": "$.jobs.Run-Implementor-Checks"
          },
          "checks": [
            {
              "name": "unit"
            }
          ]
        }
      ]
    }
  ]
}
